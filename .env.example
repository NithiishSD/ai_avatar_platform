

# --- Database (PostgreSQL) Configuration ---
POSTGRES_DB=avatar_platform
POSTGRES_USER=avatar_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis Broker Configuration ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Queue & Task Routing ---
# Options: 'in_memory' (fast local testing without Celery/Redis) or 'celery' (production async GPU queue)
QUEUE_BACKEND=in_memory

# --- Broker & Backend Connection URLs ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
DATABASE_URL=postgresql://avatar_user:your_secure_password_here@localhost:5432/avatar_platform

# ---------------------------------------------------------------------------
# API authentication & rate limiting (Phase 3 / acceptance matrix)
# ---------------------------------------------------------------------------
# Auth is OFF by default so local development needs no key. Turn it on and set
# at least one key before exposing the API; AUTH_ENABLED=true with an empty
# API_KEYS rejects every request.
AUTH_ENABLED=false
API_KEYS=

# Token-bucket rate limiting, keyed on the API key when present, else the
# client IP. RATE_LIMIT_BURST allows a short spike without raising the
# sustained rate. Note: buckets are per API process, so with N uvicorn workers
# the effective limit is RATE_LIMIT_RPM x N.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=120
RATE_LIMIT_BURST=30

# Comma-separated allowed browser origins. Leave empty in development and any
# http://localhost:<port> / http://127.0.0.1:<port> is accepted, which keeps
# working when Vite falls back to another port.
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Avatar rendering
# ---------------------------------------------------------------------------
# Lip-sync engine used when a render job does not name one with ?engine=.
# 'blendshape' runs on CPU with no extra weights. 'wav2lip' needs the
# licence-gated checkpoint (scripts/fetch_vision_models.py --only wav2lip
# --accept-licence wav2lip) and fails loudly without it.
RENDER_ENGINE=blendshape

# Force the vision models (Wav2Lip, SyncNet) onto one device. Leave unset for
# automatic. Set to cpu when another process is holding the GPU.
# AVATAR_DEVICE=cpu
