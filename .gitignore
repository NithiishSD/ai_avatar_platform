# Python virtual environment
venv/
.venv/
.conda/
backend/.conda/*

# Generated audio is regenerable; the smoke cloning reference and its
# provenance record are rebuilt by scripts/make_reference.py --smoke.
inputs/smoke_reference_*

# Model weights come from scripts/fetch_models.py and
# scripts/fetch_vision_models.py, never from git: they are large, some are
# symlinks into one machine's Hugging Face cache, and Wav2Lip's licence does
# not allow redistributing it.
.models/

# Face images are never committed: a photo of a person needs that person's
# consent, and a repository is a publication. Register them locally with
# their provenance sidecar instead.
inputs/faces/*

# Everything under outputs/ is generated media (speech, renders, benchmark
# reports) and can be regenerated.
outputs/

# Faces and voice references are never committed: they are photos and
# recordings of people, and golden rule 3 makes consent a precondition of use,
# not of storage. Provenance sidecars stay local with the media they describe.
inputs/
